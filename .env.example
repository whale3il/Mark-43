# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Endpoint for external backend server (Prisma / Supabase backend)
# Defaults to '/api' if hosted on the same origin or reverse proxy.
VITE_API_URL="http://localhost:4000/api"

# VITE_REALTIME_URL: Endpoint for realtime events stream (SSE or Supabase Realtime)
VITE_REALTIME_URL="http://localhost:4000/api/realtime"

# DATABASE_URL: Supabase PostgreSQL connection string for Prisma ORM.
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# SUPABASE_URL & ANON_KEY: Supabase project coordinates
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
